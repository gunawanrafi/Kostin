    "cloudinary": "^2.3.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "jsonwebtoken": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@kostin/config": "*",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
