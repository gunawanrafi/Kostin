# ─────────────────────────────────────────────────────────────────────────────
# KostIn — Environment Variables
# Copy this file to .env and fill in all values before running any service.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by: auth, user, listing, booking, escrow, payment, review, admin, ai
DATABASE_URL=postgresql://kostin:kostin123@localhost:5432/kostin_dev
POSTGRES_DB=kostin_dev
POSTGRES_USER=kostin
POSTGRES_PASSWORD=kostin123

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used by: auth, user, listing, chat, notification, admin, ai (sessions, cache, BullMQ)
REDIS_URL=redis://localhost:6379

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Used by: chat, community
MONGODB_URL=mongodb://kostin:kostin123@localhost:27017/kostin_dev?authSource=admin

# ── auth-service (port 3001) ──────────────────────────────────────────────────
# Access token: 15m, refresh token: 7d (fixed by spec; override in seconds if needed)
JWT_SECRET=change_me_to_a_long_random_string_in_production
REFRESH_TOKEN_SECRET=another_long_random_string
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800

# Google OAuth — POST /auth/login/google
GOOGLE_CLIENT_ID=

# Twilio / ZenziVa — OTP via WhatsApp/SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── user-service (port 3002) ──────────────────────────────────────────────────
# Cloudinary — image upload & CDN
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── listing-service (port 3003) ───────────────────────────────────────────────
# Cloudinary (shared with user-service above)

# Google Maps / Mapbox — POI, routing, neighborhood data
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Elasticsearch — full-text search (Phase 2+)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ── booking-service (port 3004) ───────────────────────────────────────────────
ESCROW_SERVICE_URL=http://localhost:3005

# ── escrow-service (port 3005) ────────────────────────────────────────────────
# CRITICAL: handles real money — double-check every env var here
PAYMENT_SERVICE_URL=http://localhost:3006

# ── payment-service (port 3006) ───────────────────────────────────────────────
# Midtrans — Indonesian payment gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── chat-service (port 3007) ──────────────────────────────────────────────────
# (uses MONGODB_URL and REDIS_URL from above)

# ── notification-service (port 3008) ─────────────────────────────────────────
# Firebase FCM — push notifications
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ZenziVa — WhatsApp notification fallback
ZENZIA_API_KEY=
ZENZIA_SENDER=

# ── review-service (port 3009) ────────────────────────────────────────────────
# (uses DATABASE_URL from above)

# ── community-service (port 3010) ────────────────────────────────────────────
# (uses MONGODB_URL from above)

# ── admin-service (port 3011) ────────────────────────────────────────────────
ADMIN_JWT_SECRET=change_me_separate_from_user_jwt

# ── ai-service (port 8000) ───────────────────────────────────────────────────
# OpenAI API — AI matching & recommendations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── apps/web (port 3000) ──────────────────────────────────────────────────────
# Server-only (no NEXT_PUBLIC_ prefix) — the browser never talks to these
# directly. Next.js Route Handlers under src/app/api/* proxy to them,
# attaching the JWT read from the httpOnly auth cookie server-side.
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
LISTING_SERVICE_URL=http://localhost:3003
BOOKING_SERVICE_URL=http://localhost:3004
